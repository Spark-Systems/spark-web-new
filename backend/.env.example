# The backend's settings. Copy to backend/.env, or set them as environment
# variables (e.g. on the Windows service). Real environment variables win.

# Where the backend listens. Keep 127.0.0.1 behind IIS: only this server reaches it.
PORT=4000
HOST=127.0.0.1

# Content (JSON documents, accounts, messages, CVs, backups) and uploaded
# pictures. Relative paths are from the folder the backend runs in. On a server
# use folders outside the app (e.g. D:\spark-data\data and D:\spark-data\uploads)
# so deploys never touch them, and include them in your backups.
SPARK_DATA_DIR=data
SPARK_UPLOADS_DIR=uploads

# The website, told to refresh its pages after each publish.
FRONTEND_URL=http://127.0.0.1:3000

# Same value as SPARK_SHARED_SECRET in the website's settings. A long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SPARK_SHARED_SECRET=

# ---- Admin sign-in ----
# Signs login tokens: a random string of at least 32 characters (required in production).
# Keep it stable: changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# First admin account: with no users yet, signing in with these creates it.
# Ignored once any user exists (manage users in the admin under Users).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Google Analytics 4 for the admin dashboard (optional) ----
# From the service account JSON: client_email and private_key (one line, in
# double quotes, with the \n escapes intact). Add the service account as a
# Viewer under GA Admin > Property access management.
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
