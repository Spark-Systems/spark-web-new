# The website (this folder). Copy to .env.local for development, or set these
# as environment variables on the server. The backend has its own settings in
# backend/.env (see backend/.env.example).

# Where the website reaches the backend. Also read by `next build`, which
# pre-renders pages from it: start the backend before building.
BACKEND_URL=http://127.0.0.1:4000

# Same value as SPARK_SHARED_SECRET in backend/.env. A long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SPARK_SHARED_SECRET=
