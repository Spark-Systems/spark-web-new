# The website's settings. Copy to .env.local for development; in production
# set them on the host (e.g. AWS) as environment variables.

# The backend's address. Used when the site is built (it pre-renders pages and
# sets up forwarding of /api/admin, /api/v1 and /uploads from it) and while it
# runs, so the backend must be running and reachable at build time too.
#   Production: the backend's public HTTPS address, e.g. https://api.spark-sys.com
#   Locally:    http://127.0.0.1:4000
BACKEND_URL=http://127.0.0.1:4000

# Same value as SPARK_SHARED_SECRET in the backend's settings. Lets the backend
# tell the site to refresh after a publish, and lets the site read drafts for
# preview mode. A long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SPARK_SHARED_SECRET=
