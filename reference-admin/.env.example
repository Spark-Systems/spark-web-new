# Base URL of the Spark Systems API
NEXT_PUBLIC_API_URL=https://api.spark-sys.com/v1

# Serve requests from the in-memory mock backend (lib/api/mock). Set to "false" to hit the real API.
NEXT_PUBLIC_USE_MOCK_API=true

# Google Analytics 4 (server-only, never prefix with NEXT_PUBLIC_).
# From the service account JSON: client_email and private_key. Keep the key on one
# line in double quotes with its "\n" escapes intact. The service account must be
# added as a Viewer under GA Admin > Property access management.
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=

# Mock backend login, only used while NEXT_PUBLIC_USE_MOCK_API is on. NEXT_PUBLIC_ values end up
# in the browser bundle, so never reuse a real password here. Leave the password empty to disable
# mock login. Restart `next dev` after changing these.
NEXT_PUBLIC_MOCK_ADMIN_EMAIL=admin@spark-sys.com
NEXT_PUBLIC_MOCK_ADMIN_PASSWORD=
