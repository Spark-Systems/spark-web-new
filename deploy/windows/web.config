<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for the Spark website. Put this file in the IIS site's
  folder (an empty folder such as C:\spark\iis). Needs the URL Rewrite and
  Application Request Routing (ARR) modules, with ARR's proxy turned on.
  See deploy/windows/README.md.

  /api/admin, /api/v1 and /uploads go straight to the backend (port 4000);
  everything else to the website (port 3000).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Visitors always use HTTPS (remove this rule until a certificate is bound). -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <rule name="Backend" stopProcessing="true">
          <match url="^(api/admin|api/v1|uploads)(/.*)?$" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:4000/{R:0}" />
        </rule>

        <rule name="Website" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Uploads and CVs are up to 4 MB; leave headroom. -->
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>

    <!-- The apps send their own error pages and JSON errors. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
